<UserControl x:Class="GhostBind.App.Controls.StickVisualizer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220" Height="220">

    <Grid x:Name="Root" Width="220" Height="220">
        <!-- Outer bound -->
        <Ellipse Width="200" Height="200"
                 Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
                 StrokeThickness="1"
                 Fill="{DynamicResource ControlFillColorTertiaryBrush}" />

        <!-- Inner deadzone ring -->
        <Ellipse x:Name="InnerDeadzoneRing"
                 Stroke="{DynamicResource SystemAccentColorBrush}"
                 StrokeThickness="1"
                 StrokeDashArray="3,3"
                 Opacity="0.55"
                 Width="40" Height="40" />

        <!-- Outer deadzone ring -->
        <Ellipse x:Name="OuterDeadzoneRing"
                 Stroke="{DynamicResource SystemAccentColorBrush}"
                 StrokeThickness="1"
                 StrokeDashArray="3,3"
                 Opacity="0.35"
                 Width="200" Height="200" />

        <!-- Crosshair -->
        <Line X1="110" Y1="10" X2="110" Y2="210"
              Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
              StrokeThickness="0.5" Opacity="0.4" />
        <Line X1="10" Y1="110" X2="210" Y2="110"
              Stroke="{DynamicResource ControlStrokeColorDefaultBrush}"
              StrokeThickness="0.5" Opacity="0.4" />

        <!-- Raw position (gray) -->
        <Ellipse x:Name="RawDot"
                 Width="10" Height="10"
                 Fill="{DynamicResource TextFillColorTertiaryBrush}"
                 Opacity="0.7"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="RawTransform" X="105" Y="105" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Processed position (accent) -->
        <Ellipse x:Name="ProcessedDot"
                 Width="14" Height="14"
                 Fill="{DynamicResource SystemAccentColorBrush}"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top">
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="ProcessedTransform" X="103" Y="103" />
            </Ellipse.RenderTransform>
        </Ellipse>
    </Grid>
</UserControl>
