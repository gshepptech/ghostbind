<Application x:Class="GhostBind.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:app="clr-namespace:GhostBind.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- Cyberdeck overrides MUST come AFTER WPF-UI dictionaries so our brushes win. -->
                <ResourceDictionary Source="Themes/Cyberdeck.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <app:EnumLabelConverter x:Key="EnumLabel" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
