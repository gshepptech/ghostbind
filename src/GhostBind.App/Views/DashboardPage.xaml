<Page x:Class="GhostBind.App.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:c="clr-namespace:GhostBind.App.Controls"
      Title="Dashboard">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="Live View" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Move your sticks and triggers — this is what the game sees in real time."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,12" />

            <ui:Card Margin="0,0,0,20" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="How to read this view" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,4" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="• Gray dot = where your stick physically is (raw)" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="• Accent dot = what the game receives after your deadzone, anti-deadzone, sensitivity, and curve are applied" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="• Dashed rings = inner / outer deadzones — inside the inner ring, output is zero; outside the outer ring, output is maxed" />
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,8,0,0"
                               FontStyle="Italic"
                               Text="If raw and accent dots overlap, the game is seeing exactly what you're doing. If they're far apart, your settings are reshaping the input." />
                </StackPanel>
            </ui:Card>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Left Stick" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12" />
                        <c:StickVisualizer x:Name="LeftStickViz" HorizontalAlignment="Center" />
                        <TextBlock x:Name="LeftCoords" Text="0.00, 0.00"
                                   HorizontalAlignment="Center" Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontFamily="Consolas, Cascadia Mono" />
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="1" Margin="8,0,0,0" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Right Stick" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12" />
                        <c:StickVisualizer x:Name="RightStickViz" HorizontalAlignment="Center" />
                        <TextBlock x:Name="RightCoords" Text="0.00, 0.00"
                                   HorizontalAlignment="Center" Margin="0,12,0,0"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontFamily="Consolas, Cascadia Mono" />
                    </StackPanel>
                </ui:Card>
            </Grid>

            <ui:Card Margin="0,16,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="Triggers" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="L2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ProgressBar x:Name="LeftTriggerBar" Minimum="0" Maximum="1" Value="0" Height="14" Margin="0,4,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="R2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <ProgressBar x:Name="RightTriggerBar" Minimum="0" Maximum="1" Value="0" Height="14" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,16,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="Buttons" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12" />
                    <ItemsControl x:Name="ButtonsList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
