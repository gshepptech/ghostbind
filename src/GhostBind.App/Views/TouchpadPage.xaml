<Page x:Class="GhostBind.App.Views.TouchpadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Touchpad">

    <Page.Resources>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,2" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="Touchpad" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Use the DualSense touchpad as a mouse. Glide your finger to move the cursor — useful for HTPC / couch gaming where you don't want to grab a mouse."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,24" TextWrapping="Wrap" />

            <ui:Card Padding="20">
                <StackPanel>
                    <CheckBox x:Name="AsMouse" Content="Use touchpad as system mouse"
                              Click="OnChanged" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource HintStyle}" Margin="22,4,0,0"
                               Text="When enabled, sliding a finger on the DualSense touchpad moves the Windows mouse cursor. Touchpad CLICK is still available for button remap on the Buttons page." />

                    <TextBlock Style="{StaticResource LabelStyle}" Text="Sensitivity" />
                    <TextBlock Style="{StaticResource HintStyle}"
                               Text="How fast the cursor moves per pixel of finger travel. 1.0 ≈ 1:1 pixel mapping, 2.0 = twice as fast. Most setups want 1.5–2.5." />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>
                        <Slider Grid.Column="0" x:Name="Sens" Minimum="0.25" Maximum="4.0" SmallChange="0.05" LargeChange="0.25"
                                ValueChanged="OnSliderChanged" />
                        <TextBlock Grid.Column="1" Text="{Binding ElementName=Sens, Path=Value, StringFormat={}{0:F2}}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <CheckBox x:Name="InvX" Content="Invert X" Margin="0,0,16,0" Click="OnChanged" />
                        <CheckBox x:Name="InvY" Content="Invert Y" Click="OnChanged" />
                    </StackPanel>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,16,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="Live finger positions" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="Finger1Text" Margin="0,8,0,0" FontFamily="Consolas, Cascadia Mono"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="Finger2Text" Margin="0,4,0,0" FontFamily="Consolas, Cascadia Mono"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
