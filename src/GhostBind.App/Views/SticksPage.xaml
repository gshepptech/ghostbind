<Page x:Class="GhostBind.App.Views.SticksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:c="clr-namespace:GhostBind.App.Controls"
      xmlns:m="clr-namespace:GhostBind.Core.Mapping;assembly=GhostBind.Core"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      Title="Sticks">

    <Page.Resources>
        <ObjectDataProvider x:Key="CurveTypes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="m:CurveType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,2" />
        </Style>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="Sticks" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="Tune your sticks for the game you're playing. Move the stick — gray dot is raw, accent dot is what the game sees."
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,4,0,24" TextWrapping="Wrap" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Card Grid.Column="0" Margin="0,0,8,0" Padding="20">
                    <StackPanel x:Name="LeftPanel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Left Stick" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <c:StickVisualizer Grid.Column="1" x:Name="LeftViz" />
                        </Grid>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Inner deadzone" />
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Ignores tiny stick movements near center. Increase if your stick drifts on its own. Most controllers want 0.05–0.10." />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" x:Name="LeftInnerDz" Minimum="0" Maximum="0.5" SmallChange="0.01" LargeChange="0.05"
                                    TickFrequency="0.05" IsSnapToTickEnabled="False" ValueChanged="OnLeftSliderChanged" />
                            <ui:NumberBox Grid.Column="1" Margin="8,0,0,0" Value="{Binding ElementName=LeftInnerDz, Path=Value, Mode=TwoWay}" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                        </Grid>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Outer deadzone" />
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Where the stick reads as 'fully pushed.' Lower it if your stick can't physically reach the corners — output saturates earlier so you still get max range." />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" x:Name="LeftOuterDz" Minimum="0.5" Maximum="1.0" SmallChange="0.01" LargeChange="0.05"
                                    ValueChanged="OnLeftSliderChanged" />
                            <ui:NumberBox Grid.Column="1" Margin="8,0,0,0" Value="{Binding ElementName=LeftOuterDz, Path=Value, Mode=TwoWay}" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                        </Grid>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Anti-deadzone" />
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Many shooters apply their own deadzone in-game and ignore small stick movements. This boosts any non-zero output to start ABOVE that floor. Try 0.10–0.18 for Call of Duty / Apex / Halo." />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" x:Name="LeftAntiDz" Minimum="0" Maximum="0.5" SmallChange="0.01" LargeChange="0.05"
                                    ValueChanged="OnLeftSliderChanged" />
                            <ui:NumberBox Grid.Column="1" Margin="8,0,0,0" Value="{Binding ElementName=LeftAntiDz, Path=Value, Mode=TwoWay}" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                        </Grid>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Sensitivity" />
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Multiplier on output. Above 1.0 = output reaches max faster (twitchier turns). Below 1.0 = slower (more precise aim). Most players keep this at 1.0 and use the curve instead." />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" x:Name="LeftSens" Minimum="0.25" Maximum="2.0" SmallChange="0.05" LargeChange="0.1"
                                    ValueChanged="OnLeftSliderChanged" />
                            <ui:NumberBox Grid.Column="1" Margin="8,0,0,0" Value="{Binding ElementName=LeftSens, Path=Value, Mode=TwoWay}" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                        </Grid>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Response curve" />
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Shape of how stick movement maps to output. Pick Custom to drag your own. See the cheat sheet at the bottom of this page." />
                        <ComboBox x:Name="LeftCurve" ItemsSource="{Binding Source={StaticResource CurveTypes}}" SelectionChanged="OnLeftCurveChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <c:CurveEditor x:Name="LeftCurveEditor" Visibility="Collapsed" Margin="0,12,0,0" HorizontalAlignment="Center" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Curve exponent" />
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="How aggressive the curve is. Only affects Aggressive and Precision curves. Higher = stronger effect." />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" x:Name="LeftExp" Minimum="1.1" Maximum="4.0" SmallChange="0.1" LargeChange="0.5"
                                    ValueChanged="OnLeftSliderChanged" />
                            <ui:NumberBox Grid.Column="1" Margin="8,0,0,0" Value="{Binding ElementName=LeftExp, Path=Value, Mode=TwoWay}" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <CheckBox x:Name="LeftInvertX" Content="Invert X" Margin="0,0,16,0" Click="OnLeftInvertChanged" />
                            <CheckBox x:Name="LeftInvertY" Content="Invert Y" Click="OnLeftInvertChanged" />
                        </StackPanel>
                        <CheckBox x:Name="LeftAntiSnap" Content="Anti-snapback" Click="OnLeftInvertChanged" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource HintStyle}" Margin="22,2,0,0"
                                   Text="Filters phantom 'opposite direction' blips when you flick the stick back to center quickly. Turn on if you've noticed unintended inputs (worn sticks)." />
                    </StackPanel>
                </ui:Card>

                <ui:Card Grid.Column="1" Margin="8,0,0,0" Padding="20">
                    <StackPanel x:Name="RightPanel">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Right Stick" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <c:StickVisualizer Grid.Column="1" x:Name="RightViz" />
                        </Grid>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Inner deadzone" />
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Ignores tiny stick movements near center. Increase if your stick drifts on its own. Most controllers want 0.05–0.10." />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" x:Name="RightInnerDz" Minimum="0" Maximum="0.5" SmallChange="0.01"
                                    ValueChanged="OnRightSliderChanged" />
                            <ui:NumberBox Grid.Column="1" Margin="8,0,0,0" Value="{Binding ElementName=RightInnerDz, Path=Value, Mode=TwoWay}" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                        </Grid>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Outer deadzone" />
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Where the stick reads as 'fully pushed.' Lower it if your stick can't physically reach the corners — output saturates earlier so you still get max range." />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" x:Name="RightOuterDz" Minimum="0.5" Maximum="1.0" SmallChange="0.01"
                                    ValueChanged="OnRightSliderChanged" />
                            <ui:NumberBox Grid.Column="1" Margin="8,0,0,0" Value="{Binding ElementName=RightOuterDz, Path=Value, Mode=TwoWay}" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                        </Grid>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Anti-deadzone" />
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Many shooters apply their own deadzone in-game and ignore small stick movements. This boosts any non-zero output to start ABOVE that floor. Try 0.10–0.18 for Call of Duty / Apex / Halo." />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" x:Name="RightAntiDz" Minimum="0" Maximum="0.5" SmallChange="0.01"
                                    ValueChanged="OnRightSliderChanged" />
                            <ui:NumberBox Grid.Column="1" Margin="8,0,0,0" Value="{Binding ElementName=RightAntiDz, Path=Value, Mode=TwoWay}" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                        </Grid>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Sensitivity" />
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Multiplier on output. Above 1.0 = output reaches max faster (twitchier turns). Below 1.0 = slower (more precise aim). Most players keep this at 1.0 and use the curve instead." />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" x:Name="RightSens" Minimum="0.25" Maximum="2.0" SmallChange="0.05"
                                    ValueChanged="OnRightSliderChanged" />
                            <ui:NumberBox Grid.Column="1" Margin="8,0,0,0" Value="{Binding ElementName=RightSens, Path=Value, Mode=TwoWay}" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                        </Grid>

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Response curve" />
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="Shape of how stick movement maps to output. Pick Custom to drag your own. See the cheat sheet at the bottom of this page." />
                        <ComboBox x:Name="RightCurve" ItemsSource="{Binding Source={StaticResource CurveTypes}}" SelectionChanged="OnRightCurveChanged">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource EnumLabel}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <c:CurveEditor x:Name="RightCurveEditor" Visibility="Collapsed" Margin="0,12,0,0" HorizontalAlignment="Center" />

                        <TextBlock Style="{StaticResource LabelStyle}" Text="Curve exponent" />
                        <TextBlock Style="{StaticResource HintStyle}"
                                   Text="How aggressive the curve is. Only affects Aggressive and Precision curves. Higher = stronger effect." />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" x:Name="RightExp" Minimum="1.1" Maximum="4.0" SmallChange="0.1"
                                    ValueChanged="OnRightSliderChanged" />
                            <ui:NumberBox Grid.Column="1" Margin="8,0,0,0" Value="{Binding ElementName=RightExp, Path=Value, Mode=TwoWay}" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <CheckBox x:Name="RightInvertX" Content="Invert X" Margin="0,0,16,0" Click="OnRightInvertChanged" />
                            <CheckBox x:Name="RightInvertY" Content="Invert Y" Click="OnRightInvertChanged" />
                        </StackPanel>
                        <CheckBox x:Name="RightAntiSnap" Content="Anti-snapback" Click="OnRightInvertChanged" Margin="0,8,0,0" />
                        <TextBlock Style="{StaticResource HintStyle}" Margin="22,2,0,0"
                                   Text="Filters phantom 'opposite direction' blips when you flick the stick back to center quickly. Turn on if you've noticed unintended inputs (worn sticks)." />
                    </StackPanel>
                </ui:Card>
            </Grid>

            <ui:Card Margin="0,16,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="Response curves cheat sheet" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,0,0,12" />

                    <TextBlock Text="Dashed line in each preview = linear (1:1). The orange line is the actual curve. Numbers below show output at 25 / 50 / 75% input."
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               FontSize="11" Margin="0,0,0,12" TextWrapping="Wrap" />

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <c:CurvePreview Grid.Column="0" Curve="Linear" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="Linear" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="0.25 → 0.25" FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="0.50 → 0.50" FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="0.75 → 0.75" FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="1:1 — output matches input exactly. The default. No magic, no surprises." />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <c:CurvePreview Grid.Column="0" Curve="Smooth" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="Smooth" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="0.25 → 0.16" FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="0.50 → 0.50" FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="0.75 → 0.84" FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Smoothstep curve — gentle near center, accelerates toward the edges. Good general-purpose for most games. The 'feels nice' option." />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <c:CurvePreview Grid.Column="0" Curve="Aggressive" Exponent="2.0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="Aggressive (exp=2)" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="0.25 → 0.50" FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="0.50 → 0.71" FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="0.75 → 0.87" FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Output ramps up FAST at low input. Faster turning, twitchier feel. Trades fine-aim precision for quick reactions. Good for fighting games and arcade racers." />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <c:CurvePreview Grid.Column="0" Curve="Precision" Exponent="2.0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="Precision (exp=2)" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="0.25 → 0.06" FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="0.50 → 0.25" FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="0.75 → 0.56" FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Slow output near center, full speed at edges. Better fine-aim around target, fast turns when you push to the edge. The shooter's curve. Opposite of Aggressive." />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <c:CurvePreview Grid.Column="0" Curve="AntiDeadzone" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="AntiDeadzone" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="0.25 → 0.36" FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="0.50 → 0.58" FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="0.75 → 0.79" FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Boosts the bottom end past a fixed offset. Built-in alternative to the Anti-deadzone slider above. Pick this OR the slider, not both." />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <c:CurvePreview Grid.Column="0" Curve="Custom" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="Custom" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="(your shape)" FontFamily="Consolas, Cascadia Mono" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Drag the three middle anchor points on the editor (appears under the Curve dropdown when Custom is selected) to define your own shape. Preview shows the default — yours will differ." />
                    </Grid>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
