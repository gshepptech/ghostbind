<Page x:Class="GhostBind.App.Views.AutoSwitchPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Auto-Switch">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel>
            <TextBlock Text="Per-game auto-switch" FontSize="28" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <TextBlock TextWrapping="Wrap" Margin="0,4,0,16"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Pair an exe name with a profile. GhostBind polls the foreground window every 2 seconds — when you alt-tab into a paired game, the matching profile loads automatically. Use the lower-cased exe name without the .exe extension (e.g. cyberpunk2077, r5apex, eldenring)." />

            <ui:Card Padding="20">
                <StackPanel>
                    <CheckBox x:Name="EnabledBox" Content="Enable per-game auto-switch"
                              Click="OnEnabledChanged" FontWeight="SemiBold" />
                    <TextBlock x:Name="CurrentForegroundText" Margin="22,4,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,16,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="Add mapping" FontWeight="SemiBold" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox Grid.Column="0" x:Name="NewExe" PlaceholderText="exe name (no .exe)" Margin="0,0,8,0" />
                        <ComboBox  Grid.Column="1" x:Name="NewProfile" />
                        <ui:Button Grid.Column="2" Content="Add" Appearance="Primary" Margin="8,0,0,0" Click="OnAdd" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <ui:Card Margin="0,16,0,0" Padding="20">
                <StackPanel>
                    <TextBlock Text="Mappings" FontWeight="SemiBold" Margin="0,0,0,8"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ItemsControl x:Name="MappingsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Exe}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontFamily="Consolas, Cascadia Mono" />
                                    <TextBlock Grid.Column="1" Text="{Binding Profile}" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ui:Button Grid.Column="2" Content="Remove" Tag="{Binding Exe}" Click="OnRemove" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</Page>
