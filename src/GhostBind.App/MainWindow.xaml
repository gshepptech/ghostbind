<ui:FluentWindow x:Class="GhostBind.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:GhostBind.App.Views"
                 xmlns:tb="http://www.hardcodet.net/taskbar"
                 Title="GhostBind"
                 Width="1180" Height="760"
                 MinWidth="900" MinHeight="600"
                 WindowBackdropType="None"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 TextOptions.TextFormattingMode="Display"
                 TextOptions.TextRenderingMode="ClearType">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <tb:TaskbarIcon x:Name="NotifyIcon"
                        ToolTipText="GhostBind"
                        TrayLeftMouseDown="OnTrayLeftClick"
                        Visibility="Visible">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show GhostBind" Click="OnTrayShow" />
                    <Separator />
                    <MenuItem Header="Restart service" Click="OnTrayRestart" />
                    <Separator />
                    <MenuItem Header="Exit" Click="OnTrayExit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Hero zone (Grid.Row=0): synthwave gradient + branding, with TitleBar
             overlaid (transparent) so OS min/max/close buttons sit on top. -->
        <Grid Grid.Row="0" Height="72">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF0A0820" Offset="0" />
                    <GradientStop Color="#FF1A1A55" Offset="0.35" />
                    <GradientStop Color="#FF2A1545" Offset="0.65" />
                    <GradientStop Color="#FF0A0820" Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Decorative diagonal stripes on the right side, neon cyan -->
            <Canvas HorizontalAlignment="Right" Width="320" ClipToBounds="True" Opacity="0.55" Margin="0,0,160,0">
                <Rectangle Canvas.Right="20"  Canvas.Top="-10" Width="3" Height="120" Fill="#FF00E5FF" Opacity="0.45">
                    <Rectangle.RenderTransform><RotateTransform Angle="22" /></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Canvas.Right="60"  Canvas.Top="-10" Width="2" Height="120" Fill="#FF00E5FF" Opacity="0.30">
                    <Rectangle.RenderTransform><RotateTransform Angle="22" /></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Canvas.Right="100" Canvas.Top="-10" Width="2" Height="120" Fill="#FFFF3D9E" Opacity="0.25">
                    <Rectangle.RenderTransform><RotateTransform Angle="22" /></Rectangle.RenderTransform>
                </Rectangle>
                <Rectangle Canvas.Right="140" Canvas.Top="-10" Width="1" Height="120" Fill="#FFFF3D9E" Opacity="0.16">
                    <Rectangle.RenderTransform><RotateTransform Angle="22" /></Rectangle.RenderTransform>
                </Rectangle>
            </Canvas>

            <!-- Brand mark + name. Tall outlined ghost — dark body, neon cyan→magenta
                 gradient stroke, slit eyes. "Ghosty boy" cool-and-aloof energy. -->
            <StackPanel Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                <Grid Width="40" Height="52" VerticalAlignment="Center">
                    <Grid.Effect>
                        <DropShadowEffect Color="#FF00E5FF" BlurRadius="28" ShadowDepth="0" Opacity="0.7" />
                    </Grid.Effect>

                    <!-- Outline ghost: dark fill, neon gradient stroke. -->
                    <Path Stretch="Uniform" StrokeThickness="3" StrokeLineJoin="Round">
                        <Path.Fill>
                            <SolidColorBrush Color="#FF0A0815" />
                        </Path.Fill>
                        <Path.Stroke>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF00E5FF" Offset="0" />
                                <GradientStop Color="#FFA855F7" Offset="0.5" />
                                <GradientStop Color="#FFFF3D9E" Offset="1" />
                            </LinearGradientBrush>
                        </Path.Stroke>
                        <Path.Data>
                            <PathGeometry Figures="M 5,50 A 45,45 0 0,1 95,50 L 95,115 L 78,103 L 60,118 L 50,108 L 40,118 L 22,103 L 5,115 Z" />
                        </Path.Data>
                    </Path>

                    <!-- Slit eyes: two narrow horizontal lines in cyan, cool/aloof vibe. -->
                    <Canvas>
                        <Rectangle Canvas.Left="9"  Canvas.Top="22" Width="8" Height="2.5" Fill="#FF00E5FF" RadiusX="1" RadiusY="1" />
                        <Rectangle Canvas.Left="23" Canvas.Top="22" Width="8" Height="2.5" Fill="#FF00E5FF" RadiusX="1" RadiusY="1" />
                    </Canvas>
                </Grid>

                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="GhostBind"
                               FontFamily="Bahnschrift Condensed, Bahnschrift, Segoe UI Variable Display, Segoe UI"
                               FontWeight="Bold" FontSize="26"
                               Foreground="#FFFFEAD8" />
                    <TextBlock Text="bind without a trace"
                               FontFamily="Segoe UI Variable Display, Segoe UI"
                               FontStyle="Italic" FontSize="11"
                               Foreground="#FFFFB873"
                               FontWeight="Normal"
                               Margin="0,-2,0,0" />
                </StackPanel>
            </StackPanel>

            <!-- Bottom glow accent line — cyan→magenta sweep -->
            <Border VerticalAlignment="Bottom" Height="2">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="Transparent" Offset="0" />
                        <GradientStop Color="#FF00E5FF" Offset="0.35" />
                        <GradientStop Color="#FFFF3D9E" Offset="0.65" />
                        <GradientStop Color="Transparent" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#FF00E5FF" BlurRadius="14" ShadowDepth="0" Opacity="0.6" />
                </Border.Effect>
            </Border>

            <!-- TitleBar overlay: transparent, sits on top so OS min/max/close buttons appear over the hero -->
            <ui:TitleBar Title="" VerticalAlignment="Top" Background="Transparent" />
        </Grid>

        <ui:NavigationView Grid.Row="1"
                           x:Name="RootNavigation"
                           PaneDisplayMode="Left"
                           OpenPaneLength="220"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="True"
                           Background="{DynamicResource GhostBindSidebarBackground}">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Dashboard" TargetPageType="{x:Type views:DashboardPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="DataBarVertical24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Sticks" TargetPageType="{x:Type views:SticksPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Games24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Triggers" TargetPageType="{x:Type views:TriggersPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Triangle24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Buttons" TargetPageType="{x:Type views:ButtonsPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Keyboard24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Touchpad" TargetPageType="{x:Type views:TouchpadPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Cursor24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Lighting" TargetPageType="{x:Type views:LightingPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Color24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Presets" TargetPageType="{x:Type views:PresetsPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Sparkle24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Tuning Guide" TargetPageType="{x:Type views:TuningGuidePage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="BookOpen24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Profiles" TargetPageType="{x:Type views:ProfilesPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="DocumentMultiple24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="Auto-Switch" TargetPageType="{x:Type views:AutoSwitchPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="ArrowSwap24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings" TargetPageType="{x:Type views:SettingsPage}">
                    <ui:NavigationViewItem.Icon><ui:SymbolIcon Symbol="Settings24" /></ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <Border Grid.Row="2"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource SystemAccentColorBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="StatusText" Text="Idle" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text=" — Profile: " VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="ProfileText" Text="Default" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="BatteryText" Text="" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               FontFamily="Consolas, Cascadia Mono" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
