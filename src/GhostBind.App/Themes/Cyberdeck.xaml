<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- "Neon Drift" — deep navy with dual-neon (cyan + magenta) accents.
         Cyan is the primary accent (buttons, sliders, focus). Magenta is the
         secondary, used for gradient borders and the brand mark stroke. -->

    <!-- Accent (cyan primary) -->
    <Color x:Key="SystemAccentColor">#FF00E5FF</Color>
    <Color x:Key="SystemAccentColorPrimary">#FF00E5FF</Color>
    <Color x:Key="SystemAccentColorSecondary">#FF3DDCFF</Color>
    <Color x:Key="SystemAccentColorTertiary">#FF66E8FF</Color>
    <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#FF00E5FF" />
    <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#FF00E5FF" />
    <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#FF3DDCFF" />

    <!-- Magenta secondary accent — for gradient borders and brand stroke -->
    <SolidColorBrush x:Key="MagentaAccentBrush" Color="#FFFF3D9E" />

    <!-- Backgrounds — deep navy with subtle violet undertone at the top -->
    <RadialGradientBrush x:Key="ApplicationBackgroundBrush"
                         Center="0.5,-0.05" GradientOrigin="0.5,-0.05"
                         RadiusX="1.4" RadiusY="0.95">
        <GradientStop Color="#FF1B1240" Offset="0" />
        <GradientStop Color="#FF0E0822" Offset="0.45" />
        <GradientStop Color="#FF050310" Offset="1" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush" Color="#FF0A0815" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorSecondaryBrush" Color="#FF0F0B22" />
    <SolidColorBrush x:Key="SolidBackgroundFillColorTertiaryBrush" Color="#FF15102A" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FF15102A" />
    <SolidColorBrush x:Key="LayerFillColorAltBrush" Color="#FF1F1838" />

    <!-- Control fills — cool dark with violet hint -->
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FF1B1638" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FF252045" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FF120E26" />
    <SolidColorBrush x:Key="ControlFillColorDisabledBrush" Color="#FF0F0B22" />
    <SolidColorBrush x:Key="ControlAltFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ControlAltFillColorSecondaryBrush" Color="#FF1F1838" />
    <SolidColorBrush x:Key="ControlAltFillColorTertiaryBrush" Color="#FF15102A" />
    <SolidColorBrush x:Key="ControlAltFillColorQuarternaryBrush" Color="#FF1A1432" />
    <SolidColorBrush x:Key="ControlAltFillColorDisabledBrush" Color="#FF0F0B22" />

    <!-- Strokes — cool slate-violet -->
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF3A3068" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FF231D45" />
    <SolidColorBrush x:Key="ControlStrokeColorOnAccentDefaultBrush" Color="#9900E5FF" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#FF584890" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDisabledBrush" Color="#FF231D45" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFEEF0FF" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FFB0B4D0" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#FF7C7E9C" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#FF4E4E66" />
    <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#FF0A0815" />
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FF051018" />
    <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#CC051018" />
    <SolidColorBrush x:Key="TextOnAccentFillColorDisabledBrush" Color="#80051018" />

    <!-- Cards — dual-neon gradient border for the RGB-ish vibe -->
    <LinearGradientBrush x:Key="CardBackgroundFillColorDefaultBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF252045" Offset="0" />
        <GradientStop Color="#FF15102A" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FF120E26" />
    <LinearGradientBrush x:Key="CardStrokeColorDefaultBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#5500E5FF" Offset="0" />
        <GradientStop Color="#33A855F7" Offset="0.5" />
        <GradientStop Color="#55FF3D9E" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardStrokeColorDefaultSolidBrush" Color="#FF3A3068" />

    <!-- Subtle (hover/pressed) — cyan tint -->
    <SolidColorBrush x:Key="SubtleFillColorTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#3300E5FF" />
    <SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#1A00E5FF" />
    <SolidColorBrush x:Key="SubtleFillColorDisabledBrush" Color="Transparent" />

    <!-- Accent fills (primary buttons / focused controls) -->
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF00E5FF" />
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF3DDCFF" />
    <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF66E8FF" />
    <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#FF1F4858" />
    <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF00E5FF" />
    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#FF3DDCFF" />

    <!-- Status colors -->
    <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FF7AE572" />
    <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFFFD93D" />
    <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFFF3D5C" />

    <!-- TitleBar transparent so hero gradient shows through -->
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TitleBarInactiveBackgroundBrush" Color="Transparent" />

    <!-- Sidebar -->
    <LinearGradientBrush x:Key="GhostBindSidebarBackground" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF120E28" Offset="0" />
        <GradientStop Color="#FF080515" Offset="1" />
    </LinearGradientBrush>

    <!-- Hero strip background — synthwave horizontal sweep, cyan to magenta -->
    <LinearGradientBrush x:Key="GhostBindHeroBackground" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FF0A0820" Offset="0" />
        <GradientStop Color="#FF1A1A55" Offset="0.35" />
        <GradientStop Color="#FF2A1545" Offset="0.65" />
        <GradientStop Color="#FF0A0820" Offset="1" />
    </LinearGradientBrush>

    <!-- Typography -->
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>

    <!-- Card style: gradient bg + dual-neon gradient border. No DropShadowEffect
         (causes text fuzziness inside cards). -->
    <Style TargetType="ui:Card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</ResourceDictionary>
